# Neon / PostgreSQL (pooled) — REQUIRED on Vercel
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=60"

JWT_SECRET="change-me-to-a-long-random-secret"
JWT_REFRESH_SECRET="change-me-to-another-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=5000
NODE_ENV=production

# Frontend origin(s) for CORS — comma-separated if multiple
FRONTEND_URL="https://your-frontend.vercel.app"
# Optional extra origins
# ALLOWED_ORIGINS="https://another-domain.com"

UPLOAD_DIR="./uploads"

# Neon / PostgreSQL connection string
# Use the pooled endpoint and keep connect_timeout high for Neon cold starts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=60"

# Strong secrets required in production (min 32 characters)
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_REFRESH_SECRET="change-me-to-another-long-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# Public URL of the frontend (for CORS)
FRONTEND_URL="http://localhost:5173"

# Local upload storage path
UPLOAD_DIR="./uploads"

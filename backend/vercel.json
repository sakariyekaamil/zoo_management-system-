{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "./",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "buildCommand": "npx prisma generate"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "api" }
    }
  ]
}
